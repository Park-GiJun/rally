# rally — 환경변수 예시 (이 파일은 커밋된다. 실제 값은 .env 에 넣고 .env 는 커밋하지 않는다)
#
# 로컬 dev: backend 의 springboot4-dotenv(developmentOnly)가 repo 루트의 .env 를 자동 로드한다.
#           application.yml 의 ${DB_URL:...} 같은 placeholder 가 .env 값으로 채워진다.
# 운영:     이 변수들을 실제 환경변수/시크릿으로 주입한다(.env 미사용). 실제 환경변수가 .env 보다 우선.
#
# 시작하려면:  cp .env.example .env  후 값 채우기. 로컬 H2 만 쓸 거면 DB_* 는 비워도 동작(yml 기본값).

# ───────── 앱: 영속성 (PostgreSQL) ─────────
# 로컬 H2 로 띄울 거면 아래 3개를 비워두면 application.yml 기본값(H2 PostgreSQL 모드)으로 동작.
DB_URL=jdbc:postgresql://localhost:5432/rally
DB_USERNAME=rally
DB_PASSWORD=
JPA_DDL_AUTO=update

# ───────── 앱: Redis (P1+) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────── 앱: Kafka (P1+) ─────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ───────── 앱: JWT (gateway·user-service 가 반드시 동일하게 공유) ─────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=rally
JWT_VALIDITY_MINUTES=1440

# ───────── 앱: 메일 (Brevo SMTP, 발신 @gijun.net) ─────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@gijun.net

# ───────── 서비스 디스커버리 ─────────
EUREKA_URL=http://localhost:18861/eureka/

# ───────── /ship 파이프라인: Jira·Notion·Slack 리소스 ID (인증은 MCP 가, 값은 식별자) ─────────
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=RP
NOTION_DATA_SOURCE_ID=
NOTION_COMMIT_LOG_PAGE_ID=
SLACK_CHANNEL_ID=

# ───────── 배포 인프라 (홈서버) ─────────
# 공유 인프라에 연결할 때 사용. dev PC 가 같은 LAN 이면 INTERNAL, 외부면 PUBLIC 호스트 사용.
INFRA_HOST_PUBLIC=
INFRA_HOST_INTERNAL=
# 홈서버 공유 인프라 포트(참고): pgsql 5432 · redis 6380 · kafka 9094 · es 9201 · kafka-ui 8089 · grafana 3001
