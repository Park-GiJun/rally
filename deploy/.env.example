# rally 배포 환경변수 — deploy/.env 로 복사해 값을 채운다. deploy/.env 는 커밋 금지(.gitignore).
# 공유 인프라(infra-postgres)의 rally DB 자격증명과 JWT 시크릿만 있으면 된다.
# (config-server 주소·eureka 주소·DB 호스트는 compose 가 컨테이너명으로 주입하므로 여기 둘 필요 없음.)

# ── 영속성 (공유 PostgreSQL 의 rally DB) ──
DB_USERNAME=stocksim
DB_PASSWORD=

# ── JWT (gateway 검증 · user-service 발급 — 동일 값 필수) ──
JWT_SECRET=
JWT_ISSUER=rally
JWT_VALIDITY_MINUTES=1440
